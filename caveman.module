<?php
/**
 * @file
 * Caveman filter - transforms text into caveman speech.
 */

/**
 * Caveman configuration info mapping for config UI.
 */
function caveman_config_info() {
  $prefixes['caveman.grunt'] = array(
    'label' => t('Caveman Settings'),
    'group' => t('Configuration'),
  );
  return $prefixes;
}

/**
 * Implements hook_menu().
 */
function caveman_menu() {
  $items['admin/config/content/caveman'] = array(
    'title' => 'Caveman settings',
    'description' => 'Configure Caveman filter.',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('caveman_admin_settings'),
    'access arguments' => array('administer filters'),
    'file' => 'caveman.admin.inc',
  );
  return $items;
}

/**
 * Implements hook_filter_info().
 */
function caveman_filter_info() {
  $filters['caveman'] = array(
    'title' => t('Caveman filter'),
    'description' => t('Make text sound like a caveman.'),
    'process callback' => 'caveman_filter_process',
    'settings callback' => 'caveman_filter_settings',
    'default settings' => array(
      'caveman_display_tip' => 1,
      'intensity' => 'medium',
    ),
    'tips callback' => 'caveman_filter_tips',
  );
  return $filters;
}

/**
 * Filter settings callback.
 */
function caveman_filter_settings($form, $form_state, $filter, $format, $defaults = array()) {
  $settings['intensity'] = array(
    '#type' => 'select',
    '#title' => t('Caveman intensity'),
    '#options' => array(
      'low' => t('Low'),
      'medium' => t('Medium'),
      'high' => t('UNGA (High)'),
    ),
    '#default_value' => isset($filter->settings['intensity']) ? $filter->settings['intensity'] : 'medium',
  );

  $settings['caveman_display_tip'] = array(
    '#type' => 'checkbox',
    '#title' => t('Display Caveman filter tip'),
    '#default_value' => isset($filter->settings['caveman_display_tip']) ? $filter->settings['caveman_display_tip'] : 1,
  );

  return $settings;
}

/**
 * Main filter process.
 */
function caveman_filter_process($text, $filter = NULL) {
  $override = config_get('caveman.grunt', 'caveman_override');
  $is_april_fools = (format_date(REQUEST_TIME, 'custom', 'md') == '0401');

  if (!$override && !$is_april_fools) {
    return $text;
  }

  $intensity = isset($filter->settings['intensity']) ? $filter->settings['intensity'] : 'medium';

  // Protect certain tags.
  $ignore_tags = 'a|script|style|code|pre';
  $open_tag = '';
  $chunks = preg_split('/(<.+?>)/is', $text, -1, PREG_SPLIT_DELIM_CAPTURE);

  for ($i = 0; $i < count($chunks); $i++) {
    if (!empty($chunks[$i]) && $chunks[$i][0] != '<') {
      // Skip text within ignored tags such as links, code and script blocks.
      if ($open_tag == '') {
        $chunks[$i] = caveman_transform($chunks[$i], $intensity);
      }
    }
    else {
      if ($open_tag == '') {
        if (preg_match("`<($ignore_tags)(?:\s|>)`i", $chunks[$i], $matches)) {
          $open_tag = $matches[1];
        }
      }
      else {
        if (preg_match("`</$open_tag>`i", $chunks[$i])) {
          $open_tag = '';
        }
      }
    }
  }

  return implode('', $chunks);
}

/**
 * Core transformation pipeline.
 */
function caveman_transform($text, $intensity = 'medium') {

  // --- 1. Phrase replacements ---
  $text = preg_replace([
    '%\bthank you\b%i',
    '%\bthanks\b%i',
    '%\bhow are you\b%i',
    '%\bI am\b%i',
    '%\bI will\b%i',
    '%\bI have\b%i',
    '%\bgoing to\b%i',
    '%\bdo not\b%i',
    '%\bdon\'t\b%i',
    '%\bcan\'t\b%i',
  ], [
    'UNGA',
    'UNGA',
    'you good?',
    'me',
    'me gonna',
    'me got',
    'gonna',
    'no',
    'no',
    'no can',
  ], $text);

  // --- 2. Word replacements ---
  $text = preg_replace([
    '%\bI\b%i',
    '%\bmy\b%i',
    '%\bmine\b%i',
    '%\bthey\b%i',
    '%\bis\b%i',
    '%\bare\b%i',
    '%\bwas\b%i',
    '%\bwere\b%i',
    '%\bhave\b%i',
    '%\bhas\b%i',
    '%\bhello\b%i',
    '%\bhi\b%i',
    '%\bfriend\b%i',
    '%\bcomputer\b%i',
    '%\binternet\b%i',
    '%\bhouse\b%i',
  ], [
    'me',
    'me',
    'me',
    'them',
    'be',
    'be',
    'be',
    'be',
    'got',
    'got',
    'UGH',
    'UGH',
    'cave-friend',
    'magic rock',
    'big web',
    'cave',
  ], $text);

  // --- 3. Structure ---
  if ($intensity !== 'low') {
    $text = preg_replace('/,\s*/', '. ', $text);
    $text = preg_replace('/\bbecause\b/i', '.', $text);
  }

  // --- 4. Article trimming ---
  $text = preg_replace('%\bthe\b%i', '', $text);

  // --- 5. Cleanup ---
  $text = preg_replace('/\s+/', ' ', $text);
  $text = preg_replace('/\s+([.,!?])/', '$1', $text);

  // --- 6. Flavor ---
  if ($intensity === 'high') {
    if (rand(0, 3) === 0) {
      $text = 'me think ' . $text;
    }
    if (rand(0, 3) === 0) {
      $text .= ' UNGA!';
    }
  }

  return trim($text);
}

/**
 * Filter tips.
 */
function caveman_filter_tips($filter, $format, $long = FALSE) {
  if (!empty($filter->settings['caveman_display_tip'])) {
    return t('Ugh. Caveman speak enabled. Keep text short and strong.');
  }
  return NULL;
}
